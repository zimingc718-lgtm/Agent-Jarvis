# Copy to .env.local and fill in every value, then restart the dev server.
# Verify with: npm run config:check     Details: docs/LOCAL_CONFIGURATION.md

# Agent-Jarvis own account (Google OAuth). All four are required before the
# sign-in button appears; NEXTAUTH_URL must match the port you run on and the
# Google console redirect URI http://<host>/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED. Encrypts provider API keys at rest; the app refuses to open the
# store without it (a signed-in page would otherwise fail at runtime).
JARVIS_SECRET_KEY=
JARVIS_DB_PATH=.data/agent-jarvis.sqlite
